<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/release_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_release_background">
    <TextView android:id="@+id/release_widget_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/release_title" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
    <LinearLayout android:id="@+id/release_widget_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
</LinearLayout>
