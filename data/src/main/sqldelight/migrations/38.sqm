CREATE TRIGGER cloud_sync_subscription_insert AFTER INSERT ON release_subscription
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND ((SELECT source FROM mangas WHERE _id=new.entry_id) NOT IN (SELECT source FROM cloud_sync_excluded_sources))
BEGIN
    INSERT OR REPLACE INTO cloud_sync_dirty(kind, source, title, item, removed)
    SELECT 'subscription', source, url, '', 0 FROM mangas WHERE _id=new.entry_id;
END;

CREATE TRIGGER cloud_sync_subscription_update AFTER UPDATE ON release_subscription
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND ((SELECT source FROM mangas WHERE _id=new.entry_id) NOT IN (SELECT source FROM cloud_sync_excluded_sources))
BEGIN
    INSERT OR REPLACE INTO cloud_sync_dirty(kind, source, title, item, removed)
    SELECT 'subscription', source, url, '', 0 FROM mangas WHERE _id=new.entry_id;
END;

CREATE TRIGGER cloud_sync_subscription_delete BEFORE DELETE ON release_subscription
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND ((SELECT source FROM mangas WHERE _id=old.entry_id) NOT IN (SELECT source FROM cloud_sync_excluded_sources))
BEGIN
    INSERT OR REPLACE INTO cloud_sync_dirty(kind, source, title, item, removed)
    SELECT 'subscription', source, url, '', 1 FROM mangas WHERE _id=old.entry_id;
END;

-- Only dirty references are journaled here; serialization and encryption run outside user writes.
CREATE TABLE cloud_sync_control (
    singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
    enabled INTEGER NOT NULL DEFAULT 0,
    suppressed INTEGER NOT NULL DEFAULT 0,
    incognito INTEGER NOT NULL DEFAULT 0
);
INSERT INTO cloud_sync_control(singleton) VALUES(1);

CREATE TABLE cloud_sync_excluded_sources (source INTEGER NOT NULL PRIMARY KEY);

CREATE TABLE cloud_sync_category_ids (
    local_id INTEGER NOT NULL PRIMARY KEY,
    shared_id TEXT NOT NULL UNIQUE
);

CREATE TABLE cloud_sync_dirty (
    revision INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    kind TEXT NOT NULL,
    source INTEGER NOT NULL,
    title TEXT NOT NULL,
    item TEXT NOT NULL DEFAULT '',
    removed INTEGER NOT NULL DEFAULT 0,
    changed_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s', 'now') AS INTEGER) * 1000),
    UNIQUE(kind, source, title, item)
);

CREATE TRIGGER cloud_sync_title_insert AFTER INSERT ON mangas
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND (new.favorite = 1 AND new.is_syncing = 0 AND new.source NOT IN (SELECT source FROM cloud_sync_excluded_sources))
BEGIN
    INSERT OR REPLACE INTO cloud_sync_dirty(kind, source, title, item, removed) VALUES('title', new.source, new.url, '', 0);
END;

CREATE TRIGGER cloud_sync_title_update AFTER UPDATE OF favorite, viewer, chapter_flags, date_added, title, author, artist, description, genre, status, thumbnail_url ON mangas
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND (new.is_syncing = 0 AND new.source NOT IN (SELECT source FROM cloud_sync_excluded_sources) AND (old.favorite IS NOT new.favorite OR old.viewer IS NOT new.viewer OR old.chapter_flags IS NOT new.chapter_flags OR old.date_added IS NOT new.date_added OR old.title IS NOT new.title OR old.author IS NOT new.author OR old.artist IS NOT new.artist OR old.description IS NOT new.description OR old.genre IS NOT new.genre OR old.status IS NOT new.status OR old.thumbnail_url IS NOT new.thumbnail_url) AND (new.favorite = 1 OR old.favorite = 1 OR EXISTS(SELECT 1 FROM chapters WHERE manga_id = new._id AND (read = 1 OR bookmark = 1 OR last_page_read > 0))))
BEGIN
    INSERT OR REPLACE INTO cloud_sync_dirty(kind, source, title, item, removed) VALUES('title', new.source, new.url, '', 0);
END;

CREATE TRIGGER cloud_sync_title_delete BEFORE DELETE ON mangas
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND (old.source NOT IN (SELECT source FROM cloud_sync_excluded_sources))
BEGIN
    INSERT OR REPLACE INTO cloud_sync_dirty(kind, source, title, item, removed) VALUES('title', old.source, old.url, '', 1);
END;

CREATE TRIGGER cloud_sync_item_insert AFTER INSERT ON chapters
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND (new.is_syncing = 0 AND (SELECT source FROM mangas WHERE _id = new.manga_id) NOT IN (SELECT source FROM cloud_sync_excluded_sources) AND (new.read = 1 OR new.bookmark = 1 OR new.last_page_read > 0))
BEGIN
    INSERT OR REPLACE INTO cloud_sync_dirty(kind, source, title, item) SELECT 'item', source, url, new.url FROM mangas WHERE _id = new.manga_id;
END;

CREATE TRIGGER cloud_sync_item_update AFTER UPDATE OF read, bookmark, last_page_read ON chapters
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND (new.is_syncing = 0 AND (SELECT source FROM mangas WHERE _id = new.manga_id) NOT IN (SELECT source FROM cloud_sync_excluded_sources) AND (old.read IS NOT new.read OR old.bookmark IS NOT new.bookmark OR old.last_page_read IS NOT new.last_page_read))
BEGIN
    INSERT OR REPLACE INTO cloud_sync_dirty(kind, source, title, item) SELECT 'item', source, url, new.url FROM mangas WHERE _id = new.manga_id;
END;

CREATE TRIGGER cloud_sync_history_insert AFTER INSERT ON history
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND ((SELECT T.source FROM mangas T JOIN chapters I ON I.manga_id=T._id WHERE I._id=new.chapter_id) NOT IN (SELECT source FROM cloud_sync_excluded_sources))
BEGIN
    INSERT OR REPLACE INTO cloud_sync_dirty(kind, source, title, item, removed) SELECT 'history', T.source, T.url, I.url, 0 FROM mangas T JOIN chapters I ON I.manga_id=T._id WHERE I._id=new.chapter_id;
END;

CREATE TRIGGER cloud_sync_category_insert AFTER INSERT ON categories
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND (new._id > 0)
BEGIN
    INSERT OR REPLACE INTO cloud_sync_dirty(kind, source, title, item, removed) VALUES('category', 0, '', CAST(new._id AS TEXT), 0);
END;

CREATE TRIGGER cloud_sync_membership_insert AFTER INSERT ON mangas_categories
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND ((SELECT source FROM mangas WHERE _id=new.manga_id) NOT IN (SELECT source FROM cloud_sync_excluded_sources))
