    INSERT OR REPLACE INTO cloud_sync_dirty(kind, source, title, item, removed) SELECT 'membership', source, url, '', 0 FROM mangas WHERE _id=new.manga_id;
END;

CREATE TRIGGER cloud_sync_tracking_insert AFTER INSERT ON manga_sync
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND ((SELECT source FROM mangas WHERE _id=new.manga_id) NOT IN (SELECT source FROM cloud_sync_excluded_sources))
BEGIN
    INSERT OR REPLACE INTO cloud_sync_dirty(kind, source, title, item, removed) SELECT 'tracking', source, url, CAST(new.sync_id AS TEXT), 0 FROM mangas WHERE _id=new.manga_id;
END;

CREATE TRIGGER cloud_sync_history_update AFTER UPDATE OF last_read ON history
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND ((SELECT T.source FROM mangas T JOIN chapters I ON I.manga_id=T._id WHERE I._id=new.chapter_id) NOT IN (SELECT source FROM cloud_sync_excluded_sources))
BEGIN
    INSERT OR REPLACE INTO cloud_sync_dirty(kind, source, title, item, removed) SELECT 'history', T.source, T.url, I.url, 0 FROM mangas T JOIN chapters I ON I.manga_id=T._id WHERE I._id=new.chapter_id;
END;

