WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND ((SELECT source FROM animes WHERE _id=new.anime_id) NOT IN (SELECT source FROM cloud_sync_excluded_sources))
BEGIN
    INSERT OR REPLACE INTO cloud_sync_dirty(kind, source, title, item, removed) SELECT 'tracking', source, url, CAST(new.sync_id AS TEXT), 0 FROM animes WHERE _id=new.anime_id;
END;

CREATE TRIGGER cloud_sync_history_update AFTER UPDATE OF last_seen ON animehistory
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND ((SELECT T.source FROM animes T JOIN episodes I ON I.anime_id=T._id WHERE I._id=new.episode_id) NOT IN (SELECT source FROM cloud_sync_excluded_sources))
BEGIN
    INSERT OR REPLACE INTO cloud_sync_dirty(kind, source, title, item, removed) SELECT 'history', T.source, T.url, I.url, 0 FROM animes T JOIN episodes I ON I.anime_id=T._id WHERE I._id=new.episode_id;
END;

