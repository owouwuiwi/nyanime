DROP TRIGGER IF EXISTS cloud_sync_history_delete;
CREATE TRIGGER cloud_sync_history_delete BEFORE DELETE ON animehistory
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND ((SELECT T.source FROM animes T JOIN episodes I ON I.anime_id=T._id WHERE I._id=old.episode_id) NOT IN (SELECT source FROM cloud_sync_excluded_sources))
BEGIN
    DELETE FROM cloud_sync_dirty WHERE (kind, source, title, item) IN (SELECT 'history', T.source, T.url, I.url FROM animes T JOIN episodes I ON I.anime_id=T._id WHERE I._id=old.episode_id);
    INSERT INTO cloud_sync_dirty(kind, source, title, item, removed) SELECT 'history', T.source, T.url, I.url, 1 FROM animes T JOIN episodes I ON I.anime_id=T._id WHERE I._id=old.episode_id;
END;

