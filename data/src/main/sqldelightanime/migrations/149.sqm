WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND ((SELECT source FROM animes WHERE _id=new.entry_id) NOT IN (SELECT source FROM cloud_sync_excluded_sources))
