-- Explicit replacement keeps journal revisions fresh even when an outer UPSERT
-- overrides trigger conflict handling. Both writes remain in the user transaction.

DROP TRIGGER IF EXISTS cloud_sync_title_insert;
CREATE TRIGGER cloud_sync_title_insert AFTER INSERT ON animes
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND (new.favorite = 1 AND new.is_syncing = 0 AND new.source NOT IN (SELECT source FROM cloud_sync_excluded_sources))
BEGIN
    DELETE FROM cloud_sync_dirty WHERE kind = 'title' AND source = new.source AND title = new.url AND item = '';
    INSERT INTO cloud_sync_dirty(kind, source, title, item, removed) VALUES('title', new.source, new.url, '', 0);
END;

DROP TRIGGER IF EXISTS cloud_sync_title_update;
CREATE TRIGGER cloud_sync_title_update AFTER UPDATE OF favorite, viewer, episode_flags, date_added, title, author, artist, description, genre, status, thumbnail_url, memo, season_flags, season_number, season_source_order, background_url ON animes
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND (new.is_syncing = 0 AND new.source NOT IN (SELECT source FROM cloud_sync_excluded_sources) AND (old.favorite IS NOT new.favorite OR old.viewer IS NOT new.viewer OR old.episode_flags IS NOT new.episode_flags OR old.date_added IS NOT new.date_added OR old.title IS NOT new.title OR old.author IS NOT new.author OR old.artist IS NOT new.artist OR old.description IS NOT new.description OR old.genre IS NOT new.genre OR old.status IS NOT new.status OR old.thumbnail_url IS NOT new.thumbnail_url OR old.memo IS NOT new.memo OR old.season_flags IS NOT new.season_flags OR old.season_number IS NOT new.season_number OR old.season_source_order IS NOT new.season_source_order OR old.background_url IS NOT new.background_url) AND (new.favorite = 1 OR old.favorite = 1 OR EXISTS(SELECT 1 FROM episodes WHERE anime_id = new._id AND (seen = 1 OR bookmark = 1 OR last_second_seen > 0))))
BEGIN
    DELETE FROM cloud_sync_dirty WHERE kind = 'title' AND source = new.source AND title = new.url AND item = '';
    INSERT INTO cloud_sync_dirty(kind, source, title, item, removed) VALUES('title', new.source, new.url, '', 0);
END;

DROP TRIGGER IF EXISTS cloud_sync_title_delete;
CREATE TRIGGER cloud_sync_title_delete BEFORE DELETE ON animes
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND (old.source NOT IN (SELECT source FROM cloud_sync_excluded_sources))
BEGIN
    DELETE FROM cloud_sync_dirty WHERE kind = 'title' AND source = old.source AND title = old.url AND item = '';
    INSERT INTO cloud_sync_dirty(kind, source, title, item, removed) VALUES('title', old.source, old.url, '', 1);
END;

DROP TRIGGER IF EXISTS cloud_sync_item_insert;
CREATE TRIGGER cloud_sync_item_insert AFTER INSERT ON episodes
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND (new.is_syncing = 0 AND (SELECT source FROM animes WHERE _id = new.anime_id) NOT IN (SELECT source FROM cloud_sync_excluded_sources) AND (new.seen = 1 OR new.bookmark = 1 OR new.last_second_seen > 0))
BEGIN
    DELETE FROM cloud_sync_dirty WHERE (kind, source, title, item) IN (SELECT 'item', source, url, new.url FROM animes WHERE _id = new.anime_id);
    INSERT INTO cloud_sync_dirty(kind, source, title, item) SELECT 'item', source, url, new.url FROM animes WHERE _id = new.anime_id;
END;

DROP TRIGGER IF EXISTS cloud_sync_item_update;
CREATE TRIGGER cloud_sync_item_update AFTER UPDATE OF seen, bookmark, last_second_seen, total_seconds, fillermark, memo ON episodes
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND (new.is_syncing = 0 AND (SELECT source FROM animes WHERE _id = new.anime_id) NOT IN (SELECT source FROM cloud_sync_excluded_sources) AND (old.seen IS NOT new.seen OR old.bookmark IS NOT new.bookmark OR old.last_second_seen IS NOT new.last_second_seen OR old.total_seconds IS NOT new.total_seconds OR old.fillermark IS NOT new.fillermark OR old.memo IS NOT new.memo))
BEGIN
    DELETE FROM cloud_sync_dirty WHERE (kind, source, title, item) IN (SELECT 'item', source, url, new.url FROM animes WHERE _id = new.anime_id);
    INSERT INTO cloud_sync_dirty(kind, source, title, item) SELECT 'item', source, url, new.url FROM animes WHERE _id = new.anime_id;
END;

DROP TRIGGER IF EXISTS cloud_sync_history_insert;
CREATE TRIGGER cloud_sync_history_insert AFTER INSERT ON animehistory
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND ((SELECT T.source FROM animes T JOIN episodes I ON I.anime_id=T._id WHERE I._id=new.episode_id) NOT IN (SELECT source FROM cloud_sync_excluded_sources))
BEGIN
    DELETE FROM cloud_sync_dirty WHERE (kind, source, title, item) IN (SELECT 'history', T.source, T.url, I.url FROM animes T JOIN episodes I ON I.anime_id=T._id WHERE I._id=new.episode_id);
    INSERT INTO cloud_sync_dirty(kind, source, title, item, removed) SELECT 'history', T.source, T.url, I.url, 0 FROM animes T JOIN episodes I ON I.anime_id=T._id WHERE I._id=new.episode_id;
END;

DROP TRIGGER IF EXISTS cloud_sync_category_insert;
CREATE TRIGGER cloud_sync_category_insert AFTER INSERT ON categories
WHEN (SELECT enabled = 1 AND suppressed = 0 AND incognito = 0 FROM cloud_sync_control WHERE singleton = 1)
AND (new._id > 0)
BEGIN
    DELETE FROM cloud_sync_dirty WHERE kind = 'category' AND source = 0 AND title = '' AND item = CAST(new._id AS TEXT);
    INSERT INTO cloud_sync_dirty(kind, source, title, item, removed) VALUES('category', 0, '', CAST(new._id AS TEXT), 0);
END;

